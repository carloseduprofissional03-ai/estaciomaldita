-- =====================================================================
-- Da Nascente a Foz — dados na nuvem (Fase 2)
-- 1) Tabelas primeiro, depois funcoes/triggers/RLS/views/grants/bucket
-- =====================================================================

create table if not exists public.profiles (
  id uuid primary key references auth.users(id) on delete cascade,
  full_name text not null default '',
  role text not null default 'user' check (role in ('user','admin')),
  created_at timestamptz not null default now()
);

create table if not exists public.reports (
  id text primary key default gen_random_uuid()::text,
  category text not null,
  title text not null,
  description text not null,
  reference text not null,
  lat double precision not null,
  lng double precision not null,
  photo_url text,
  contact text,
  status text not null default 'pending' check (status in ('pending','approved','rejected')),
  resolved boolean not null default false,
  resolution_note text,
  created_at timestamptz not null default now()
);

create table if not exists public.cleanup_events (
  id text primary key default gen_random_uuid()::text,
  title text not null,
  description text not null,
  location_name text not null,
  date text not null,
  start_time text not null,
  end_time text not null,
  volunteers_target integer,
  signup_count integer not null default 0,
  proposer_name text not null,
  proposer_contact text,
  status text not null default 'pending' check (status in ('pending','approved','cancelled')),
  created_at timestamptz not null default now()
);

create table if not exists public.event_signups (
  id text primary key default gen_random_uuid()::text,
  event_id text not null references public.cleanup_events(id) on delete cascade,
  name text not null,
  email text not null,
  phone text,
  created_at timestamptz not null default now(),
  unique (event_id, email)
);

create table if not exists public.news (
  id text primary key default gen_random_uuid()::text,
  title text not null,
  summary text not null,
  body text not null,
  cover_url text,
  author text not null,
  status text not null default 'pending' check (status in ('pending','approved')),
  created_at timestamptz not null default now()
);

create table if not exists public.gallery_photos (
  id text primary key default gen_random_uuid()::text,
  title text not null,
  description text,
  image_url text not null,
  author text not null,
  status text not null default 'pending' check (status in ('pending','approved')),
  created_at timestamptz not null default now()
);

-- 2) Funcoes auxiliares
create or replace function public.is_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.profiles p
    where p.id = auth.uid() and p.role = 'admin'
  );
$$;

create or replace function public.bump_signup_count()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  update public.cleanup_events
     set signup_count = signup_count + 1
   where id = new.event_id;
  return new;
end;
$$;

-- 3) Trigger do contador de inscritos
create trigger trg_bump_signup_count
after insert on public.event_signups
for each row execute function public.bump_signup_count();

-- 4) RLS habilitada em todas as tabelas
ALTER TABLE public.profiles ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.reports ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.cleanup_events ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.event_signups ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.news ENABLE ROW LEVEL SECURITY;
ALTER TABLE public.gallery_photos ENABLE ROW LEVEL SECURITY;

-- profiles: cada usuario ve/edita o proprio perfil
create policy "profiles_own_select" on public.profiles
  for select to authenticated using (auth.uid() = id);
create policy "profiles_own_update" on public.profiles
  for update to authenticated using (auth.uid() = id) with check (auth.uid() = id);

-- reports: moderador controla tudo; publico so insere como pendente
create policy "reports_admin_all" on public.reports
  for all to authenticated using (public.is_admin()) with check (public.is_admin());
create policy "reports_anon_submit" on public.reports
  for insert to anon with check (status = 'pending' and coalesce(resolved, false) = false);

-- cleanup_events
create policy "events_admin_all" on public.cleanup_events
  for all to authenticated using (public.is_admin()) with check (public.is_admin());
create policy "events_anon_submit" on public.cleanup_events
  for insert to anon with check (status = 'pending');

-- news
create policy "news_admin_all" on public.news
  for all to authenticated using (public.is_admin()) with check (public.is_admin());
create policy "news_anon_submit" on public.news
  for insert to anon with check (status = 'pending');

-- gallery_photos
create policy "photos_admin_all" on public.gallery_photos
  for all to authenticated using (public.is_admin()) with check (public.is_admin());
create policy "photos_anon_submit" on public.gallery_photos
  for insert to anon with check (status = 'pending');

-- event_signups: inscricao aberta; sem leitura publica
create policy "signups_insert" on public.event_signups
  for insert to anon, authenticated with check (true);

-- 5) Views publicas (aprovadas, sem colunas privadas)
create or replace view public.approved_reports
with (security_barrier = true) as
select id, category, title, description, reference, lat, lng, photo_url,
       status, resolved, resolution_note, created_at
from public.reports
where status = 'approved';

create or replace view public.approved_cleanup_events
with (security_barrier = true) as
select id, title, description, location_name, date, start_time, end_time,
       volunteers_target, signup_count, proposer_name, status, created_at
from public.cleanup_events
where status = 'approved';

create or replace view public.approved_news
with (security_barrier = true) as
select id, title, summary, body, cover_url, author, status, created_at
from public.news
where status = 'approved';

create or replace view public.approved_gallery_photos
with (security_barrier = true) as
select id, title, description, image_url, author, status, created_at
from public.gallery_photos
where status = 'approved';

-- 6) Grants
revoke all on public.profiles from anon;
revoke all on public.reports, public.cleanup_events, public.news, public.gallery_photos, public.event_signups from anon;
revoke all on public.event_signups from authenticated;

GRANT SELECT, INSERT, UPDATE, DELETE ON public.profiles TO authenticated;
GRANT SELECT, INSERT, UPDATE, DELETE ON public.reports, public.cleanup_events, public.news, public.gallery_photos TO authenticated;
GRANT INSERT ON public.reports, public.cleanup_events, public.news, public.gallery_photos TO anon;
GRANT INSERT ON public.event_signups TO anon, authenticated;
GRANT SELECT ON public.approved_reports, public.approved_cleanup_events, public.approved_news, public.approved_gallery_photos TO anon, authenticated;

-- 7) Bucket publico de fotos da comunidade
insert into storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
values ('nascfz', 'nascfz', true, 5242880, array['image/jpeg','image/png','image/webp'])
on conflict (id) do nothing;

create policy "nascfz_public_read" on storage.objects
  for select to anon, authenticated using (bucket_id = 'nascfz');
create policy "nascfz_public_insert" on storage.objects
  for insert to anon, authenticated with check (bucket_id = 'nascfz');